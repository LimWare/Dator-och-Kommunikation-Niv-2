<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Datorhårdvara & BIOS/UEFI - Träningsmodul</title>
  <style>
    :root {
      --bg: #0f172a;
      --card-bg: #1e293b;
      --card-border: #334155;
      --text-main: #f8fafc;
      --text-sub: #94a3b8;
      --primary: #38bdf8;
      --primary-hover: #0ea5e9;
      --success: #22c55e;
      --success-bg: rgba(34, 197, 94, 0.15);
      --error: #ef4444;
      --error-bg: rgba(239, 68, 68, 0.15);
      --input-bg: #0f172a;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg);
      color: var(--text-main);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      line-height: 1.5;
      padding: 24px 16px;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .container {
      width: 100%;
      max-width: 760px;
    }

    header {
      margin-bottom: 24px;
      text-align: center;
    }

    header h1 {
      font-size: 1.6rem;
      font-weight: 700;
      color: var(--primary);
      margin-bottom: 6px;
    }

    header p {
      color: var(--text-sub);
      font-size: 0.95rem;
    }

    .progress-bar-container {
      width: 100%;
      height: 8px;
      background: var(--card-border);
      border-radius: 999px;
      overflow: hidden;
      margin: 16px 0 20px 0;
    }

    .progress-bar {
      height: 100%;
      background: var(--primary);
      width: 0%;
      transition: width 0.3s ease;
    }

    .stats-bar {
      display: flex;
      justify-content: space-between;
      color: var(--text-sub);
      font-size: 0.9rem;
      margin-bottom: 12px;
      font-weight: 500;
    }

    .card {
      background-color: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 24px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    }

    .question-title {
      font-size: 1.15rem;
      font-weight: 600;
      margin-bottom: 8px;
      color: var(--text-main);
    }

    .prompt-label {
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--primary);
      margin-bottom: 4px;
    }

    textarea {
      width: 100%;
      min-height: 120px;
      background: var(--input-bg);
      border: 1px solid var(--card-border);
      border-radius: 8px;
      color: var(--text-main);
      padding: 12px;
      font-family: inherit;
      font-size: 0.95rem;
      resize: vertical;
      margin-top: 8px;
      margin-bottom: 16px;
    }

    textarea:focus {
      outline: none;
      border-color: var(--primary);
    }

    .facit-box {
      background: rgba(15, 23, 42, 0.7);
      border: 1px solid var(--card-border);
      border-radius: 8px;
      padding: 16px;
      margin-bottom: 16px;
      display: none;
    }

    .facit-box.active {
      display: block;
    }

    .facit-title {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--success);
      margin-bottom: 6px;
      text-transform: uppercase;
    }

    .facit-text {
      font-size: 0.95rem;
      color: var(--text-main);
      white-space: pre-line;
      line-height: 1.6;
    }

    .keywords-box {
      margin-top: 12px;
      padding-top: 12px;
      border-top: 1px solid var(--card-border);
    }

    .keywords-title {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-sub);
      margin-bottom: 8px;
      text-transform: uppercase;
    }

    .keyword-pill {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 600;
      margin: 2px 4px 2px 0;
      background: var(--card-border);
      color: var(--text-sub);
    }

    .keyword-pill.matched {
      background: var(--success-bg);
      color: var(--success);
      border: 1px solid var(--success);
    }

    .actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 12px;
    }

    button {
      padding: 10px 18px;
      border-radius: 8px;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      border: none;
      transition: all 0.2s ease;
    }

    .btn-primary {
      background: var(--primary);
      color: #0f172a;
    }

    .btn-primary:hover {
      background: var(--primary-hover);
    }

    .btn-correct {
      background: var(--success);
      color: #0f172a;
      margin-left: 8px;
    }

    .btn-repeat {
      background: var(--error);
      color: #ffffff;
    }

    .summary-screen {
      display: none;
      text-align: center;
    }

    .summary-screen.active {
      display: block;
    }

    .summary-title {
      font-size: 1.5rem;
      margin-bottom: 8px;
      color: var(--primary);
    }

    .repeat-list {
      margin-top: 16px;
      text-align: left;
      background: var(--input-bg);
      padding: 16px;
      border-radius: 8px;
      border: 1px solid var(--card-border);
    }

    .repeat-list ul {
      padding-left: 20px;
      margin-top: 8px;
    }

    .repeat-list li {
      margin-bottom: 8px;
      font-size: 0.9rem;
      color: var(--text-sub);
    }

    .repeat-list li strong {
      color: var(--text-main);
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>Datorhårdvara & BIOS/UEFI</h1>
      <p>Öva aktiv återkallning på dina 16 instuderingsfrågor</p>
    </header>

    <div class="stats-bar">
      <span id="progress-text">Fråga 1 av 16</span>
      <span id="score-text">Poäng: 0</span>
    </div>

    <div class="progress-bar-container">
      <div class="progress-bar" id="progress-bar"></div>
    </div>

    <!-- Active Question Card -->
    <div class="card" id="question-card">
      <div class="prompt-label" id="card-label">Fråga</div>
      <h2 class="question-title" id="question-text"></h2>

      <label class="prompt-label" for="user-answer">Ditt svar:</label>
      <textarea id="user-answer" placeholder="Skriv ditt svar här innan du kollar facit..."></textarea>

      <!-- Facit Box -->
      <div class="facit-box" id="facit-box">
        <div class="facit-title">Facit</div>
        <div class="facit-text" id="facit-text"></div>
        <div class="keywords-box">
          <div class="keywords-title">Matchade nyckelord</div>
          <div id="keywords-container"></div>
        </div>
      </div>

      <!-- Button Controls -->
      <div class="actions" id="action-controls">
        <button class="btn-primary" id="btn-check">Kontrollera svar</button>
        <div id="eval-controls" style="display: none;">
          <button class="btn-repeat" id="btn-repeat">Behöver öva mer</button>
          <button class="btn-correct" id="btn-correct">Jag kunde detta (+1)</button>
        </div>
      </div>
    </div>

    <!-- Summary Screen -->
    <div class="card summary-screen" id="summary-card">
      <h2 class="summary-title">Övningen avslutad!</h2>
      <p id="summary-score" style="font-size: 1.15rem; margin-bottom: 12px;"></p>
      
      <div class="repeat-list" id="repeat-container" style="display: none;">
        <h3 style="color: var(--error); font-size: 1rem;">Frågor att repetera:</h3>
        <ul id="repeat-list"></ul>
      </div>

      <div style="margin-top: 24px;">
        <button class="btn-primary" id="btn-restart">Starta om omgången</button>
      </div>
    </div>
  </div>

  <script>
    const QUESTIONS = [
      {
        id: 1,
        title: "Kommandoradsverktyg",
        prompt: "Vilka är de olika kommandoradsverktyg som låter användare styra datorn med textbaserade kommandon?",
        keywords: ["Command Prompt", "cmd", "PowerShell", "skript", "automatisering", "Windows Terminal", "WSL", "Linux"],
        answer: "• Command Prompt (cmd.exe): Används för enklare kommandon som fil- och mapphantering samt nätverksverktyg.\n• PowerShell: Kraftfullare och stöder skript och automatisering.\n• Windows Terminal: En modern samlingsplats som kan köra cmd, PowerShell och Linux-kommandon via WSL under samma tak."
      },
      {
        id: 2,
        title: "CPU-komponenter",
        prompt: "Vilka delar består en CPU av och vad gör de?",
        keywords: ["CU", "Styrenhet", "ALU", "Registers", "Cache", "Minne", "Bussar", "Klockan", "Cykler"],
        answer: "• CU (styrenheten): Bestämmer instruktioner och styr processorn.\n• ALU: Utför beräkningar och logik.\n• Registers: Sparar tillfälliga värden direkt i CPU.\n• Cache: Lagrar ofta använda data nära processorn.\n• Minne: Ger tillgång till RAM/cache.\n• Bussar: Transporterar signaler och data mellan processorns komponenter och övriga datorn.\n• Klockan: Synkroniserar processorns alla operationer och sätter hastigheten i antal cykler per sekund."
      },
      {
        id: 3,
        title: "Felsöka PSU",
        prompt: "Vad kan man använda för att felsöka en PSU (nätaggregat)?",
        keywords: ["Multimeter", "Spänning", "Ström", "Motstånd", "Elektriska värden"],
        answer: "En multimeter, vilket är ett mätverktyg som mäter elektriska värden som ström, spänning och motstånd i en elektronisk krets eller enhet."
      },
      {
        id: 4,
        title: "Felsöka RAM",
        prompt: "Vad kan man använda för att felsöka RAM och hur använder man dem?",
        keywords: ["Windows Memory Diagnostic", "MemTest86", "Start-menyn", "USB", "CD", "Omstart"],
        answer: "• Windows Memory Diagnostic: Söks upp i Start-menyn och testar minnet automatiskt vid omstart.\n• MemTest86: Ett mer avancerat verktyg som startas via ett bootbart USB-minne eller CD innan Windows laddas för att hitta fel som Windows eget verktyg kan missa."
      },
      {
        id: 5,
        title: "Felsöka Hårddiskar",
        prompt: "Hur felsöker man Hårddiskar?",
        keywords: ["Diagnostikprogram", "Tillverkarnas", "SeaTools", "Data Lifeguard", "Sektorer", "Dåliga sektorer"],
        answer: "Genom att köra tillverkarnas egna diagnostikprogram (t.ex. Seagate SeaTools eller Western Digital Data Lifeguard Diagnostic) för att analysera disken och hitta problem som dåliga sektorer eller långsamma delar."
      },
      {
        id: 6,
        title: "Felsöka Moderkort",
        prompt: "Hur felsöker man ett moderkort på enklast sätt?",
        keywords: ["Kondensatorer", "Puckarna", "Minimal hårdvara", "Nätaggregat", "CPU", "RAM"],
        answer: "1. Kontrollera kondensatorerna (de små puckarna/cylindrarna som stabiliserar strömmen) så att de är hela och inte buktar eller läcker.\n2. Starta sedan med minimal hårdvara: endast moderkort, nätaggregat (PSU), processor (CPU) och en enda RAM-modul för att utesluta att andra komponenter orsakar startproblemen."
      },
      {
        id: 7,
        title: "POST (Power-On Self Test)",
        prompt: "Vad är POST och hur fungerar det?",
        keywords: ["Power-On Self Test", "Självtest", "BIOS", "UEFI", "Pipkoder", "Felmeddelanden"],
        answer: "Power-On Self Test är ett självtest som BIOS/UEFI kör direkt vid start för att kontrollera att CPU, RAM, grafikkort, tangentbord och diskar fungerar innan systemet laddas. Om något felar varnar datorn med pipkoder eller felmeddelanden på skärmen."
      },
      {
        id: 8,
        title: "Bootstrap Loader",
        prompt: "Hur fungerar en Bootstrap Loader?",
        keywords: ["POST", "Kernel", "Kärna", "RAM", "MBR", "Boot-sektorn", "GPT", "ESP", "EFI System Partition"],
        answer: "Den startar efter POST för att ladda operativsystemets kärna (kernel) till RAM.\n• På äldre diskar söker BIOS efter MBR och läser boot-sektorn.\n• På moderna GPT-diskar letar UEFI istället efter en EFI System Partition (ESP) där bootloadern ligger och startas ifrån."
      },
      {
        id: 9,
        title: "BIOS och dess funktion",
        prompt: "Vad är ett BIOS och vad gör det?",
        keywords: ["Basic Input/Output System", "I/O", "Starta", "Tangentbord", "Hårddiskar", "Skärm"],
        answer: "Basic Input/Output System hjälper till att starta upp systemet och tillhandahåller inbyggda I/O-funktioner. Dessa funktioner gör det möjligt för datorn att kommunicera med och läsa/skriva till skärm, tangentbord och hårddiskar innan operativsystemet har tagit över."
      },
      {
        id: 10,
        title: "AHCI-gränssnittet",
        prompt: "Vad är AHCI och vilka fördelar har det jämfört med äldre ATA?",
        keywords: ["AHCI", "SATA", "ATA", "NCQ", "Native Command Queuing", "SSD", "Prestanda"],
        answer: "En modernare teknik för SATA-hårddiskar och SSD:er jämfört med gamla ATA. Fördelarna är Native Command Queuing (NCQ) för optimerad läsordning, samt att den ger bättre prestanda och är optimerad för SSD."
      },
      {
        id: 11,
        title: "Core Multi-Processing",
        prompt: "Vad är Core Multi-Processing och när använder man det respektive stänger av det?",
        keywords: ["Kärnor", "Prestanda", "Enabled", "Disabled", "Spel", "Kompatibilitet"],
        answer: "Gör att alla processorkärnor kan arbeta samtidigt för att öka datorns prestanda.\n• Ska vara aktiverad (Enabled) vid spel, krävande program och multitasking.\n• Inaktiveras (Disabled) endast om man felsöker äldre program som har kompatibilitetsproblem med flera kärnor."
      },
      {
        id: 12,
        title: "Intel Virtualization Technology",
        prompt: "Vad är Intel Virtualization Technology (Intel VT-x) och när används det?",
        keywords: ["VT-x", "Virtuella maskiner", "Operativsystem", "VMware", "VirtualBox", "Hyper-V"],
        answer: "Intel VT-x tillåter datorn att köra flera operativsystem samtidigt via virtuella maskiner. Den aktiveras när du vill köra program som VMware, VirtualBox eller Hyper-V."
      },
      {
        id: 13,
        title: "Power Management",
        prompt: "Vad är Power Management i BIOS/UEFI?",
        keywords: ["Strömförbrukning", "Energi", "Batteritid", "Viloläge", "Bärbara"],
        answer: "En meny i BIOS/UEFI där man ställer in hur datorn hanterar sin strömförbrukning och hur den ska bete sig när den inte används aktivt, vilket sparar energi och förlänger bärbara datorers batteritid."
      },
      {
        id: 14,
        title: "Wake-on-LAN",
        prompt: "Vad är Wake-on-LAN och hur fungerar det?",
        keywords: ["Wake-on-LAN", "Startas", "Väckas", "Viloläge", "Nätverket", "Nätverksförfrågan"],
        answer: "Gör att datorn kan startas om eller väckas upp från viloläge på distans via nätverket när en nätverksförfrågan skickas till den."
      },
      {
        id: 15,
        title: "Primary Boot Sequence",
        prompt: "Beskriv inställningar för Primary Boot Sequence med två typiska exempel.",
        keywords: ["Ordningsföljd", "Sekvens", "USB", "Hårddisk", "CD/DVD", "Installera"],
        answer: "Det bestämmer i vilken ordningsföljd datorn söker efter ett startbart system.\n• Sekvens 1 (USB först, sedan CD/DVD, sist hårddisk): Används om du vill installera via USB.\n• Sekvens 2 (Hårddisk först, sedan USB och CD/DVD): Används för vanlig snabb uppstart direkt från den installerade disken."
      },
      {
        id: 16,
        title: "Anledningar till BIOS-uppdatering",
        prompt: "Vilka kan anledningarna till en BIOS-uppdatering vara?",
        keywords: ["Kompatibilitet", "Ny hårdvara", "Buggfixar", "Prestanda", "Spectre", "Meltdown", "Säkerhet"],
        answer: "Kompabilitet med ny hårdvara (nyare CPU eller RAM), buggfixar för kända fel, förbättrad prestanda, nya funktioner samt säkerhetsförbättringar mot sårbarheter som Spectre och Meltdown."
      }
    ];

    let currentIndex = 0;
    let score = 0;
    let reviewList = [];

    const questionTextEl = document.getElementById("question-text");
    const userAnswerEl = document.getElementById("user-answer");
    const facitBoxEl = document.getElementById("facit-box");
    const facitTextEl = document.getElementById("facit-text");
    const keywordsContainerEl = document.getElementById("keywords-container");
    const btnCheckEl = document.getElementById("btn-check");
    const evalControlsEl = document.getElementById("eval-controls");
    const btnCorrectEl = document.getElementById("btn-correct");
    const btnRepeatEl = document.getElementById("btn-repeat");
    const progressTextEl = document.getElementById("progress-text");
    const scoreTextEl = document.getElementById("score-text");
    const progressBarEl = document.getElementById("progress-bar");
    const questionCardEl = document.getElementById("question-card");
    const summaryCardEl = document.getElementById("summary-card");
    const summaryScoreEl = document.getElementById("summary-score");
    const repeatContainerEl = document.getElementById("repeat-container");
    const repeatListEl = document.getElementById("repeat-list");
    const btnRestartEl = document.getElementById("btn-restart");

    function renderQuestion() {
      if (currentIndex >= QUESTIONS.length) {
        showSummary();
        return;
      }

      const q = QUESTIONS[currentIndex];
      questionTextEl.textContent = `${q.id}. ${q.prompt}`;
      userAnswerEl.value = "";
      userAnswerEl.disabled = false;
      facitBoxEl.classList.remove("active");
      btnCheckEl.style.display = "block";
      evalControlsEl.style.display = "none";

      progressTextEl.textContent = `Fråga ${currentIndex + 1} av ${QUESTIONS.length}`;
      scoreTextEl.textContent = `Poäng: ${score}`;
      progressBarEl.style.width = `${((currentIndex) / QUESTIONS.length) * 100}%`;
    }

    function checkAnswer() {
      const q = QUESTIONS[currentIndex];
      const userText = userAnswerEl.value.toLowerCase();

      facitTextEl.textContent = q.answer;
      keywordsContainerEl.innerHTML = "";

      q.keywords.forEach(kw => {
        const span = document.createElement("span");
        span.className = "keyword-pill";
        const isMatched = userText.includes(kw.toLowerCase());
        if (isMatched) {
          span.classList.add("matched");
          span.textContent = `✓ ${kw}`;
        } else {
          span.textContent = kw;
        }
        keywordsContainerEl.appendChild(span);
      });

      userAnswerEl.disabled = true;
      facitBoxEl.classList.add("active");
      btnCheckEl.style.display = "none";
      evalControlsEl.style.display = "flex";
    }

    function handleEvaluation(isCorrect) {
      const q = QUESTIONS[currentIndex];
      if (isCorrect) {
        score++;
      } else {
        if (!reviewList.some(item => item.id === q.id)) {
          reviewList.push(q);
        }
      }

      currentIndex++;
      renderQuestion();
    }

    function showSummary() {
      questionCardEl.style.display = "none";
      summaryCardEl.classList.add("active");
      progressBarEl.style.width = "100%";
      progressTextEl.textContent = `Avslutad (${QUESTIONS.length}/${QUESTIONS.length})`;
      scoreTextEl.textContent = `Slutpoäng: ${score}`;
      summaryScoreEl.textContent = `Du fick ${score} av ${QUESTIONS.length} poäng!`;

      if (reviewList.length > 0) {
        repeatContainerEl.style.display = "block";
        repeatListEl.innerHTML = "";
        reviewList.forEach(item => {
          const li = document.createElement("li");
          li.innerHTML = `<strong>${item.title}:</strong> ${item.prompt}`;
          repeatListEl.appendChild(li);
        });
      } else {
        repeatContainerEl.style.display = "none";
      }
    }

    function restart() {
      currentIndex = 0;
      score = 0;
      reviewList = [];
      questionCardEl.style.display = "block";
      summaryCardEl.classList.remove("active");
      renderQuestion();
    }

    btnCheckEl.addEventListener("click", checkAnswer);
    btnCorrectEl.addEventListener("click", () => handleEvaluation(true));
    btnRepeatEl.addEventListener("click", () => handleEvaluation(false));
    btnRestartEl.addEventListener("click", restart);

    // Initial setup
    renderQuestion();
  </script>
</body>
</html>
